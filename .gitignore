############################
*.class
*.jar
*.war
*.ear

.project
.classpath
.settings/
.factorypath

# Generated files
out/
build/

############################
# Maven Wrapper
# 注意：mvnw 和 Maven Wrapper jar 应该提交
############################
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.jar

